{
    "name": "electro-monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "docs:dev": "pnpm --filter website dev",
        "docs:build": "pnpm --filter website build",
        "docs:preview": "pnpm --filter website preview",
        "docs:version": "tsx scripts/version-docs.ts",
        "build": "pnpm --filter './packages/*' build",
        "test": "pnpm -r test",
        "lint": "oxlint --fix",
        "fmt": "oxfmt --write .",
        "release": "tsx scripts/release.ts",
        "publish:packages": "tsx scripts/publish.ts"
    },
    "devDependencies": {
        "lint-staged": "^17.0.5",
        "oxfmt": "^0.50.0",
        "oxlint": "^1.65.0",
        "tsdown": "catalog:",
        "tsx": "^4.22.1",
        "vite": "^8.0.13",
        "vitest": "^4.1.6"
    },
    "peerDependencies": {
        "@types/node": "^25.8.0",
        "typescript": "^6.0.3"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "oxlint --fix",
            "oxfmt --write"
        ],
        "*.{json,yaml,yml,md,css}": "oxfmt --write"
    },
    "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron"
        ]
    }
}
