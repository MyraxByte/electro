{
    "name": "electro-monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --filter './packages/*' build",
        "test": "pnpm -r test",
        "lint": "oxlint --fix",
        "fmt": "oxfmt --write .",
        "release": "tsx scripts/release.ts",
        "publish:packages": "tsx scripts/publish.ts"
    },
    "devDependencies": {
        "lint-staged": "^16.4.0",
        "oxfmt": "^0.42.0",
        "oxlint": "^1.57.0",
        "tsdown": "catalog:",
        "tsx": "^4.21.0",
        "vite": "^8.0.2",
        "vitest": "^4.1.1"
    },
    "peerDependencies": {
        "@types/node": "^25.5.0",
        "typescript": "^6.0.2"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "oxlint --fix",
            "oxfmt --write"
        ],
        "*.{json,yaml,yml,md,css}": "oxfmt --write"
    },
    "packageManager": "pnpm@10.32.1",
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron"
        ]
    }
}
