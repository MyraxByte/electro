{
    "name": "@electrojs/runtime",
    "version": "1.0.7",
    "description": "Electron main-process runtime for ElectroJS with DI, lifecycle hooks, typed IPC, and jobs",
    "keywords": [
        "dependency-injection",
        "desktop-app",
        "electrojs",
        "electron",
        "ipc",
        "runtime",
        "typescript"
    ],
    "homepage": "https://electrojs.myraxbyte.dev/",
    "bugs": {
        "url": "https://github.com/MyraxByte/electrojs/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/runtime"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./client": {
            "types": "./dist/client.d.mts",
            "import": "./dist/client.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "prepublishOnly": "tsdown --minify"
    },
    "dependencies": {
        "croner": "^10.0.1"
    },
    "devDependencies": {
        "@electrojs/common": "workspace:*",
        "@electrojs/config": "workspace:*",
        "@vitest/coverage-v8": "^4.1.1",
        "@vitest/ui": "^4.1.1",
        "publint": "^0.3.18",
        "tsdown": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@electrojs/common": "1.0.7",
        "@electrojs/config": "1.0.7",
        "@types/node": "^25.5.0",
        "electron": ">=41"
    }
}
