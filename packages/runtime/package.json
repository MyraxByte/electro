{
    "name": "@electrojs/runtime",
    "version": "1.0.3",
    "description": "Library for working with the runtime process in @electro",
    "homepage": "https://electrojs.myraxbyte.dev/",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/runtime"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./client": {
            "types": "./dist/client.d.mts",
            "import": "./dist/client.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "prepublishOnly": "tsdown --minify"
    },
    "dependencies": {
        "croner": "^10.0.1"
    },
    "devDependencies": {
        "@electrojs/common": "workspace:*",
        "@electrojs/config": "workspace:*",
        "@vitest/coverage-v8": "^4.1.1",
        "@vitest/ui": "^4.1.1",
        "publint": "^0.3.18",
        "tsdown": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@electrojs/common": "1.0.3",
        "@electrojs/config": "1.0.3",
        "@types/node": "^25.5.0",
        "electron": ">=41"
    }
}
