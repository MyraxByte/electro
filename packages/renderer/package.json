{
    "name": "@electrojs/renderer",
    "version": "1.0.10",
    "description": "Renderer-side bridge and signals client for ElectroJS Electron apps",
    "keywords": [
        "bridge",
        "electrojs",
        "electron",
        "ipc",
        "renderer",
        "signals",
        "typescript",
        "vite"
    ],
    "homepage": "https://electrojs.myraxbyte.dev/",
    "bugs": {
        "url": "https://github.com/MyraxByte/electrojs/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/renderer"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "test:browser": "vitest --browser",
        "prepublishOnly": "tsdown --minify"
    },
    "devDependencies": {
        "@electrojs/config": "workspace:*",
        "@vitest/browser-playwright": "^4.1.8",
        "@vitest/coverage-v8": "^4.1.8",
        "@vitest/ui": "^4.1.8",
        "jsdom": "^29.1.1",
        "publint": "^0.3.21",
        "tsdown": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@electrojs/config": "1.0.10"
    }
}
