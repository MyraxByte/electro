{
    "name": "@electro/renderer",
    "version": "1.0.0",
    "description": "Library for working with the renderer process in @electro",
    "homepage": "https://github.com/cordy-dev/electro#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cordy-dev/electro.git",
        "directory": "packages/renderer"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "test:browser": "vitest --browser",
        "prepublishOnly": "tsdown --minify"
    },
    "devDependencies": {
        "@electro/config": "workspace:*",
        "@vitest/browser-playwright": "^4.1.1",
        "@vitest/coverage-v8": "^4.1.1",
        "@vitest/ui": "^4.1.1",
        "jsdom": "^29.0.1",
        "publint": "^0.3.18",
        "tsdown": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@electro/config": ">=1.0.0"
    }
}
