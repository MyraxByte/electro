{
    "name": "@electrojs/codegen",
    "version": "1.0.9",
    "description": "TypeScript code generation for ElectroJS preload scripts, typed IPC, and runtime registry",
    "keywords": [
        "ast",
        "codegen",
        "electrojs",
        "electron",
        "ipc",
        "preload",
        "typescript"
    ],
    "homepage": "https://electrojs.myraxbyte.dev/",
    "bugs": {
        "url": "https://github.com/MyraxByte/electrojs/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/codegen"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "prepublishOnly": "tsdown --minify"
    },
    "dependencies": {
        "oxc-parser": "^0.128.0",
        "tinyglobby": "^0.2.16"
    },
    "devDependencies": {
        "@electrojs/common": "workspace:*",
        "@electrojs/config": "workspace:*",
        "@electrojs/runtime": "workspace:*",
        "tsdown": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@electrojs/common": "1.0.9",
        "@electrojs/config": "1.0.9",
        "@electrojs/runtime": "1.0.9",
        "@types/node": "^25.5.2"
    }
}
