{
    "name": "@electrojs/config",
    "version": "1.0.10",
    "description": "Typed config helpers for ElectroJS runtime and renderer view packages",
    "keywords": [
        "config",
        "electro",
        "electrojs",
        "electron",
        "tsconfig",
        "typescript",
        "vite"
    ],
    "homepage": "https://electrojs.myraxbyte.dev/",
    "bugs": {
        "url": "https://github.com/MyraxByte/electrojs/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/config"
    },
    "files": [
        "tsconfig/*.json",
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./tsconfig/base.json": "./tsconfig/base.json",
        "./tsconfig/library.json": "./tsconfig/library.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "prepublishOnly": "tsdown --minify"
    },
    "devDependencies": {
        "publint": "^0.3.21",
        "tsdown": "catalog:"
    },
    "peerDependencies": {
        "typescript": ">=6.0.3",
        "vite": ">=8"
    }
}
