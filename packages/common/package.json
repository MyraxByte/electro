{
    "name": "@electrojs/common",
    "version": "1.0.10",
    "description": "Decorators, DI primitives, and shared contracts for ElectroJS Electron apps",
    "keywords": [
        "decorators",
        "dependency-injection",
        "electrojs",
        "electron",
        "ipc",
        "typescript"
    ],
    "homepage": "https://electrojs.myraxbyte.dev/",
    "bugs": {
        "url": "https://github.com/MyraxByte/electrojs/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/common"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": true,
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "prepublishOnly": "tsdown --minify"
    },
    "dependencies": {
        "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
        "@electrojs/config": "workspace:*",
        "@vitest/coverage-v8": "^4.1.7",
        "@vitest/ui": "^4.1.7",
        "publint": "^0.3.21",
        "tsdown": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@electrojs/config": "1.0.10",
        "electron": ">=41"
    }
}
