{
    "name": "create-electro",
    "version": "1.0.7",
    "description": "Scaffold a new ElectroJS Electron app with the recommended monorepo layout",
    "keywords": [
        "create",
        "electro",
        "electrojs",
        "electron",
        "scaffold",
        "starter",
        "template",
        "vite"
    ],
    "homepage": "https://electrojs.myraxbyte.dev/",
    "bugs": {
        "url": "https://github.com/MyraxByte/electrojs/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/create-electro"
    },
    "bin": {
        "create-electro": "./bin/create-electro.mjs"
    },
    "files": [
        "bin",
        "dist",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown && node ./scripts/sync-templates.mjs",
        "test": "vitest",
        "prepublishOnly": "tsdown --minify && node ./scripts/sync-templates.mjs"
    },
    "devDependencies": {
        "tsdown": "catalog:",
        "vitest": "catalog:"
    }
}
