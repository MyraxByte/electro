{
    "name": "@electrojs/cli",
    "version": "1.0.4",
    "description": "CLI for ElectroJS dev, code generation, build, and preview in Electron apps",
    "keywords": [
        "build-tool",
        "cli",
        "codegen",
        "dev-server",
        "electrojs",
        "electron",
        "typescript",
        "vite"
    ],
    "homepage": "https://electrojs.myraxbyte.dev/",
    "bugs": {
        "url": "https://github.com/MyraxByte/electrojs/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MyraxByte/electrojs.git",
        "directory": "packages/cli"
    },
    "bin": {
        "electro": "./dist/index.mjs"
    },
    "files": [
        "bin",
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "prepublishOnly": "tsdown --minify"
    },
    "dependencies": {
        "cac": "^7.0.0",
        "magic-string": "^0.30.21",
        "oxc-resolver": "^11.19.1"
    },
    "devDependencies": {
        "@electrojs/codegen": "workspace:*",
        "@electrojs/config": "workspace:*",
        "@electrojs/runtime": "workspace:*",
        "tsdown": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@electrojs/codegen": "1.0.4",
        "@electrojs/config": "1.0.4",
        "@electrojs/runtime": "1.0.4",
        "@types/node": "^25.5.0",
        "electron": ">=41",
        "vite": "^8.0.2"
    }
}
